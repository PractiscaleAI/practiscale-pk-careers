{
  "name": "practiscale-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src docs scripts *.ts *.json *.mjs SETUP.md",
    "test:browser": "node scripts/qa-site.cjs",
    "test:motion": "node scripts/qa-motion.cjs",
    "test:preloader": "node scripts/qa-preloader.cjs",
    "test:layout": "node scripts/qa-layout.cjs",
    "test:composition": "node scripts/qa-composition.cjs",
    "test:mobile-hero": "node scripts/qa-mobile-editorial.cjs",
    "test:hero-finish": "node scripts/qa-hero-finish.cjs",
    "test:carousel": "node scripts/qa-problem-scroll.cjs",
    "test:problem-scroll": "node scripts/qa-problem-scroll.cjs",
    "test:scroll-navigation": "node scripts/qa-scroll-navigation.cjs",
    "test:career-section": "node scripts/qa-career-section.cjs",
    "test:typography": "node scripts/qa-typography.cjs",
    "test:earnings": "node scripts/qa-proof-band.cjs",
    "test:proof-band": "node scripts/qa-proof-band.cjs",
    "test:proof-edges": "node scripts/qa-proof-edges.cjs",
    "render:proof": "node scripts/export-proof-band.cjs",
    "test:proof-links": "node scripts/qa-proof-links.cjs",
    "test:hero-continuity": "node scripts/qa-hero-continuity.cjs",
    "test:testimonials": "node scripts/qa-testimonials.cjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "lucide-react": "1.59.0",
    "motion": "14.7.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
